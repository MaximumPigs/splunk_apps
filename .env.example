# Copy to .env (gitignored) and fill in. splk loads it automatically.
#
# Create a token in Splunk Web: Settings > Tokens > New Token. Give it to a
# user whose role can install apps and run searches (admin on a dev box).
SPLUNK_TOKEN=

# Optional: pick a different target from config/targets.toml for this checkout.
# SPLK_TARGET=local

# Splunk Web sign-in for browser tests (`splk test --ui`, `splk shot`).
# Splunk Web does not accept tokens, so the browser signs in with a username
# and password. Use a dev instance only: these sit here in plain text.
SPLUNK_WEB_USERNAME=
SPLUNK_WEB_PASSWORD=
