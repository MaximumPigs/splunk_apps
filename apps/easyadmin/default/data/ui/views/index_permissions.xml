<!--
  Simple XML rather than Dashboard Studio on purpose: the page is an editable
  form (a checkbox grid with one bulk submit), which Studio cannot express.
  The dashboard is only a host for the script in appserver/static; it runs no
  searches. version="1.1" selects the current jQuery, which AppInspect requires
  of any dashboard that loads custom JavaScript.
-->
<dashboard version="1.1" script="easyadmin_index_permissions.js" stylesheet="easyadmin_index_permissions.css" hideEdit="true">
  <label>Index permissions</label>
  <description>Which indexes each role can search. Tick or untick any number of cells, then save them all at once.</description>
  <row>
    <panel>
      <html>
        <div id="easyadmin-index-permissions">Loading roles and indexes...</div>
      </html>
    </panel>
  </row>
</dashboard>
