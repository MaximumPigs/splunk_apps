# Copy to docker/.env (gitignored) and fill in. compose.yaml passes only the
# variables it lists to the dev container. Never commit the filled-in copy.

# ---- Your Splunk instance ---------------------------------------------------
# A dev instance you run and manage separately (Developer licence: the Free
# licence turns off users and roles, which the tests need). It needs a
# `splk_test` index and a token for splk.
SPLK_TARGET_HOST=
SPLK_TARGET_PORT=8089
# true once splunkd has a certificate the container trusts.
SPLK_TARGET_VERIFY_TLS=false
# Whether the loop may restart splunkd when an install needs it. Without it,
# a deploy that needs a restart fails and the loop stops for you.
SPLK_TARGET_ALLOW_RESTART=false
# Splunk Web, for UI tests and screenshots, e.g. http://splunk.lan:8000.
SPLK_TARGET_WEB_URL=
SPLUNK_TOKEN=
SPLUNK_WEB_USERNAME=
SPLUNK_WEB_PASSWORD=

# ---- Package hand-over ------------------------------------------------------
# splk deploy installs a package by telling splunkd a path, so both sides need
# the same folder: this host folder is mounted at /stage in the container,
# and SPLK_TARGET_SERVER_STAGE_DIR is the same folder as splunkd sees it
# (e.g. a share mounted into the Splunk container or VM).
SPLK_STAGE_HOST_PATH=/mnt/user/appdata/splunk-stage
SPLK_TARGET_SERVER_STAGE_DIR=
# Owner of what the loop writes there (Unraid shares: 99 and 100).
LOOP_UID=1000
LOOP_GID=1000

# ---- The loop ---------------------------------------------------------------
REPO_URL=https://github.com/<owner>/splunk_apps.git
# Commits are authored as you: your name and GitHub noreply address.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Fine-grained token, this repo only: Contents and Pull requests read/write,
# Issues read/write, Actions read. The supervisor pushes and opens PRs with it.
GH_TOKEN=
# Optional, recommended: read-only token for the steps (Contents, Pull
# requests, Actions, Issues: read).
SPLK_LOOP_GH_TOKEN=
# From `claude setup-token` (needs a Claude subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# Optional push notifications through ntfy.
SPLK_NTFY_TOPIC=
SPLK_NTFY_TOKEN=
# Resource limits for the container.
DEV_MEM_LIMIT=8g
DEV_CPUS=4
