# Copy to docker/.env (gitignored) and fill in. compose.yaml reads it for
# both containers. Never commit the filled-in copy.

# ---- Splunk container ------------------------------------------------------
# Exact image tag, e.g. the version the apps' floor or current release uses.
SPLUNK_IMAGE=splunk/splunk:<exact version>
# Accepting Splunk's licence and general terms is your decision; the image
# will not start without them. See the image's documentation for the values.
SPLUNK_START_ARGS=
SPLUNK_GENERAL_TERMS=
SPLUNK_PASSWORD=
SPLUNK_WEB_PORT=8000
# Splunk Web is plain HTTP with the admin account: loopback by default. Set
# to the server's LAN address to reach it from the LAN.
SPLUNK_WEB_BIND=127.0.0.1
# Put the Developer licence file at docker/licence/splunk.lic.

# ---- Dev container (the loop) ---------------------------------------------
REPO_URL=https://github.com/<owner>/splunk_apps.git
# Commits are authored as you: your name and GitHub noreply address.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Fine-grained token, this repo only: Contents and Pull requests read/write,
# Issues read/write, Actions read. The supervisor pushes and opens PRs with it.
GH_TOKEN=
# Optional, recommended: read-only token for the steps (Contents, Pull
# requests, Actions, Issues: read).
SPLK_LOOP_GH_TOKEN=
# From `claude setup-token` (needs a Claude subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# Splunk token for splk (create it in Splunk Web once the container is up:
# Settings > Tokens) and the Splunk Web sign-in for UI tests.
SPLUNK_TOKEN=
SPLUNK_WEB_USERNAME=admin
SPLUNK_WEB_PASSWORD=
# Optional push notifications through ntfy.
SPLK_NTFY_TOPIC=
SPLK_NTFY_TOKEN=
