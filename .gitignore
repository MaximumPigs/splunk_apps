# ---------------------------------------------------------------------------
# Splunk apps
# ---------------------------------------------------------------------------
# Runtime state written by the Splunk UI. It is instance-specific and must not
# ship in a package: AppInspect fails a Cloud submission that contains local/.
local/
local.meta
metadata/local.meta

# Build output
dist/
*.spl
*.tar.gz
*.tgz

# AppInspect reports
appinspect_report*.html
appinspect_report*.json
*.appinspect.json

# NOTE: lib/ is deliberately NOT ignored. Splunk apps vendor their Python
# dependencies into <app>/lib/, and ignoring it would silently ship an app that
# cannot import splunklib. The stock GitHub Python .gitignore excludes lib/;
# that line must stay removed.

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.envrc
.venv
env/
venv/
ENV/

# Testing and linting
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
